# Copy to .env.local for local development. Never commit real values.
# Local Supabase values come from `npm run db:start` (or `npx supabase status`).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode: on-screen outbox for all messages and "Sign in as" for seeded
# users. Always false (or unset) in production.
DEMO_MODE=true
# Shared secret for the scheduled job endpoints (any long random string).
CRON_SECRET=
# The bot check on sign-in and register (Cloudflare Turnstile), on the live
# site only. Its secret key goes in the live project's sign-in settings
# (deploy/shifta-live), not here. Leave blank for the demo and local work.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The live site only: Supabase hands every sign-in code to the app's send
# hooks (/api/auth/hooks/sms and /email), signed with this (any long random
# string; the live workflow gives Supabase its form of it). Leave blank for
# the demo and local work, which keep codes in the outbox.
AUTH_HOOK_SECRET=

# --- Adapters (brief §8). "mock" works with no accounts. ---
# ABN Lookup is free: register at abr.business.gov.au for a GUID. Without
# one, the demo mock is used.
ABN_LOOKUP_GUID=
# Email: "mock" writes to the demo outbox; "resend" really sends (the live
# site). Resend needs an API key, and EMAIL_FROM on a domain verified in
# Resend. Replies go to EMAIL_REPLY_TO, or the support address.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Texts: "mock" writes to the demo outbox; "twilio" really sends (the live
# site), through a Twilio Messaging Service whose sender is our registered
# sender name.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Push notifications to the installed app are free (Web Push). "webpush"
# needs a pair of VAPID keys: an admin can make them on Admin > Settings.
PUSH_PROVIDER=mock
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only. Never expose to the browser.
VAPID_PRIVATE_KEY=
# Address search: "mock" knows about 150 suburbs (the demo); "google" searches
# all of Australia with Google Maps Places (the live site). Limit the key to
# the Places API (New).
GEOCODER_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# The app stores' reviewers (docs/apps.md): one worker account that signs in
# with a fixed 6-digit code, only while an admin has switched "Let the app
# stores' reviewers sign in" on (Admin > Settings > Workers). The live site
# only: leave both blank elsewhere, and never commit the real values.
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=
