# Copy to .env.local for local development. Never commit real values.
# Local Supabase values come from `npm run db:start` (or `npx supabase status`).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode: on-screen outbox for all messages and "Sign in as" for seeded
# users. Always false (or unset) in production.
DEMO_MODE=true
# Shared secret for the scheduled job endpoints (any long random string).
CRON_SECRET=

# --- Adapters (brief §8). "mock" works with no accounts. ---
# ABN Lookup is free: register at abr.business.gov.au for a GUID. Without
# one, the demo mock is used.
ABN_LOOKUP_GUID=
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# Push notifications to the installed app are free (Web Push). "webpush"
# needs a pair of VAPID keys: an admin can make them on Admin > Settings.
PUSH_PROVIDER=mock
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only. Never expose to the browser.
VAPID_PRIVATE_KEY=
GEOCODER_PROVIDER=mock
